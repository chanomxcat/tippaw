{
  "name": "tippaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tippaw-db --local",
    "admin:bootstrap-invite": "tsx scripts/admin-bootstrap-invite.ts",
    "admin:promote": "tsx scripts/admin-promote.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.2",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "minimal-shared": "^1.1.6",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simplebar-react": "^3.3.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@cloudflare/vitest-plugin": "1.3.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.51.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.143.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260926.1": true
  }
}
